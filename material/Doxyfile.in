PROJECT_NAME           = "Práctica. TDAs no lineales"
OUTPUT_DIRECTORY  = "@CMAKE_SOURCE_DIR@/@BASE_FOLDER@/doc/"
INPUT = "@CMAKE_SOURCE_DIR@/@BASE_FOLDER@/include" \
        "@CMAKE_SOURCE_DIR@/@BASE_FOLDER@/src" \
        "@CMAKE_SOURCE_DIR@/@BASE_FOLDER@/doc"
GENERATE_LATEX         = NO
IMAGE_PATH             = @CMAKE_SOURCE_DIR@/@BASE_FOLDER@/doc
EXTRACT_PRIVATE	       = NO
HIDE_UNDOC_MEMBERS = YES